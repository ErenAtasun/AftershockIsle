  baseBagSlots: 3
  rescueExtraction: 20
  hazardStress: 20
  sites:
  - name: "\u0130n\u015Faat Sahas\u0131"
    description: "Bol kalas ve hurda, az t\u0131bbi malzeme. G\xF6\xE7\xFCk riski."
    duration: 40
    loot:
    - type: 0
      min: 2
      max: 3
      weight: 60
    - type: 1
      min: 1
      max: 1
      weight: 25
    - type: 3
      min: 1
      max: 1
      weight: 15
    hazard: 1
