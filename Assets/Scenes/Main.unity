    hazardDamage: 20
    isRescueSite: 0
    mapPosition: {x: 0.18, y: 0.25}
  - name: "Y\u0131k\u0131k Klinik"
    description: "Bol ila\xE7 ve bandaj (Ya\u015Fam Kiti). Yang\u0131n ve duman riski."
    duration: 45
    loot:
    - type: 3
      min: 1
      max: 2
      weight: 70
    - type: 0
      min: 1
      max: 2
      weight: 20
    - type: 2
      min: 1
      max: 1
      weight: 10
    hazard: 2
    hazardChance: 0.3
