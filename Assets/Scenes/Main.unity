    isRescueSite: 0
    mapPosition: {x: 0.78, y: 0.2}
  - name: "Terk Edilmi\u015F At\xF6lye"
    description: "Elektronik \xE7ip, ak\xFC ve telsiz par\xE7alar\u0131. \xC7\xFCr\xFCk
      \xE7at\u0131 riski."
