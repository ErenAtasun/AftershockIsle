  dayCycle: {fileID: 1990866207}
  baseBagSlots: 3
  rescueExtraction: 20
  hazardStress: 20
  sites:
  - name: "\u0130n\u015Faat Sahas\u0131"
    description: "Bol kalas ve hurda, az t\u0131bbi malzeme. G\xF6\xE7\xFCk riski."
    duration: 40
    loot:
    - type: 0
      min: 2
      max: 3
      weight: 60
    - type: 1
      min: 1
      max: 1
      weight: 25
    - type: 3
      min: 1
      max: 1
      weight: 15
    hazard: 1
    hazardChance: 0.15
    hazardDamage: 20
    isRescueSite: 0
    mapPosition: {x: 0.18, y: 0.25}
  - name: "Y\u0131k\u0131k Klinik"
    description: "Bol ila\xE7 ve bandaj (Ya\u015Fam Kiti). Yang\u0131n ve duman riski."
    duration: 45
    loot:
    - type: 3
      min: 1
      max: 2
      weight: 70
    - type: 0
      min: 1
      max: 2
      weight: 20
    - type: 2
      min: 1
      max: 1
      weight: 10
    hazard: 2
    hazardChance: 0.3
    hazardDamage: 25
    isRescueSite: 0
    mapPosition: {x: 0.78, y: 0.2}
  - name: "Terk Edilmi\u015F At\xF6lye"
    description: "Elektronik \xE7ip, ak\xFC ve telsiz par\xE7alar\u0131. \xC7\xFCr\xFCk
      \xE7at\u0131 riski."
    duration: 50
    loot:
    - type: 2
      min: 1
      max: 1
      weight: 50
    - type: 1
      min: 1
      max: 2
      weight: 40
    - type: 0
      min: 1
      max: 2
      weight: 10
    hazard: 1
    hazardChance: 0.2
    hazardDamage: 15
    isRescueSite: 0
    mapPosition: {x: 0.2, y: 0.78}
  - name: "Enkaz Alan\u0131"
    description: "Enkaz alt\u0131nda mahsur kalanlar var. Kurtar\u0131lan ki\u015Fi
      +1 i\u015F g\xFCc\xFC ve yeni yetenek dal\u0131 getirir, ama g\xFCnl\xFCk t\xFCketimi
      de art\u0131r\u0131r."
    duration: 40
    loot:
    - type: 0
      min: 1
      max: 2
      weight: 100
    hazard: 1
    hazardChance: 0.1
    hazardDamage: 15
    isRescueSite: 1
